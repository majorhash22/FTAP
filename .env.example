# Run npm run setup:admin to create .env with a salted password hash.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
PORT=3000
HOST=127.0.0.1
PUBLIC_ORIGIN=http://127.0.0.1:3000
DATABASE_PATH=.data/ftap.sqlite
# Optional. This is a server secret; never put it in community.js.
OPENDOTA_API_KEY=
# Production requires HTTPS, PUBLIC_ORIGIN and a persistent database volume.
NODE_ENV=development
